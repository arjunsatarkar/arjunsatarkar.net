<!DOCTYPE html>
<html lang="en">
    <head>
        {{> head_boilerplate title="Writing | Arjun Satarkar"}}
        <link rel="alternate"
              href="/writing.atom"
              type="application/atom+xml"
              title="Writing | Arjun Satarkar">
        <style>
            header {
                display: flex;
                flex-wrap: wrap;
                justify-content: space-between;
            }

            #feed_anchor::before {
                content: "";
                display: inline-block;
                width: 1.2rem;
                height: 1.2rem;
                background-image: url("/assets/feed-icon/feed-icon.svg");
                background-size: contain;
                background-repeat: no-repeat;
            }

            #writing_index li {
                margin-bottom: 1rem;
            }
        </style>
    </head>
    <body>
        <header>
            <nav>
                <a href="/">&lt; Home</a>
            </nav>
            <a id="feed_anchor" href="/writing.atom">Atom feed</a>
        </header>
        <main>
            <h1>Writing</h1>
            <div id="writing_index">{{> writing_index }}</div>
        </main>
        <hr>
    </body>
</html>
